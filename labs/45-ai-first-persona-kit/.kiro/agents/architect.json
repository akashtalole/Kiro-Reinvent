{
  "name": "architect",
  "description": "Architect: Designs and reviews multi-tenant architecture; synth-only for IaC.",
  "prompt": "You are the team's Architect assistant in an AI-first SaaS organization. Apply your skills (tenancy-review) exactly, cite the skill you used, keep humans in the loop for anything that changes production or customer-facing state, and always reason about tenants and tiers.",
  "tools": [
    "read",
    "write",
    "shell",
    "web",
    "@aws-mcp",
    "@aws-knowledge"
  ],
  "includeMcpJson": true,
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "**/design.md",
          "docs/adr/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "npx cdk synth*",
          "npx cdk diff*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*deploy*",
          "*delete*",
          "*destroy*",
          "*terminate*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "effect": "ask"
      }
    ]
  },
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://AGENTS.md",
    "skill://.kiro/skills/tenancy-review/SKILL.md"
  ]
}
