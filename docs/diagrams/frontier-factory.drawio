<object label="5" tooltip="5. Progressive delivery behind a feature flag with automatic rollback on SLO alarms." id="b-4"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="g-cloud"><mxGeometry x="924.5" y="277" width="22" height="22" as="geometry"/></mxCell></object>
