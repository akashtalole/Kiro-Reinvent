<object label="6" tooltip="6. SLOs, traces and business metrics decide whether the change stays." id="b-5"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="g-prod"><mxGeometry x="84" y="173" width="22" height="22" as="geometry"/></mxCell></object>
