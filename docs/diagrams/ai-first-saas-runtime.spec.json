  "edges": [
    {
      "from": "users",
      "to": "cf",
      "step": 1,
      "label": "HTTPS",
      "desc": "Tenant users call the product over HTTPS through CloudFront."
    },
    {
      "from": "waf",
      "to": "cf",
      "style": "dashed",
      "label": "protects",
      "arrow": "end"
    },
    {
      "from": "cf",
      "to": "apigw",
      "step": 2,
      "label": "HTTPS",
      "desc": "CloudFront forwards API calls to API Gateway."
    },
    {
      "from": "apigw",
      "to": "cognito",
      "style": "dashed",
      "label": "JWT authorizer",
      "desc": "API Gateway validates the Cognito JWT; custom:tenantId and tier come from the verified token."
    },
    {
      "from": "apigw",
      "to": "svc",
      "step": 3,
      "label": "tenant ctx",
      "desc": "Requests reach tenant services with tenant context from the authorizer, never from the body."
    },
    {
      "from": "svc",
      "to": "ddb",
      "step": 4,
      "label": "LeadingKeys",
      "desc": "Tenant data in a pooled table, isolated by TENANT#id keys and IAM LeadingKeys conditions."
    },
    {
      "from": "svc",
      "to": "runtime",
      "step": 5,
      "label": "invoke agent",
      "desc": "AI features invoke a Strands agent on AgentCore Runtime with the tenant's identity."
    },
    {
      "from": "runtime",
      "to": "guard",
      "step": 6,
      "label": "screen",
      "desc": "Prompts and responses pass Bedrock Guardrails (prompt-attack and PII filters)."
    },
    {
      "from": "guard",
      "to": "models",
      "step": 7,
      "label": "Converse",
      "desc": "Model calls use the tenant's application inference profile for per-tenant cost and quotas."
    },
    {
      "from": "runtime",
      "to": "kb",
      "step": 8,
      "label": "retrieve",
      "desc": "Retrieval always filters on tenantId metadata."
    },
    {
      "from": "runtime",
      "to": "agw",
      "step": 9,
      "label": "MCP",
      "desc": "Tools are reached only through AgentCore Gateway, where Cedar policy checks tool, arguments and tenant claim."
    },
    {
      "from": "agw",
      "to": "tools",
      "step": 10,
      "label": "allowed calls",
      "desc": "Permitted tool calls run in tenant tool Lambdas."
    },
    {
      "from": "runtime",
      "to": "memory",
      "style": "dashed",
      "label": "namespace"
    },
    {
      "from": "svc",
      "to": "cw",
      "style": "dashed",
      "label": "EMF"
    },
    {
      "from": "runtime",
      "to": "cw",
      "style": "dashed",
      "label": "OTel"
    },
    {
      "from": "cw",
      "to": "devops",
      "style": "dashed",
      "label": "investigate"
    },
    {
      "from": "svc",
      "to": "iam",
      "style": "dashed",
      "label": "session tags",
      "desc": "Tenant services assume a tenant-scoped IAM role (session tag tenantId) that enforces dynamodb:LeadingKeys."
    }
  ]
}
