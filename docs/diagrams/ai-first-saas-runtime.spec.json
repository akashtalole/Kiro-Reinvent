{
  "meta": {
    "title": "AI-first SaaS on AWS \u2014 multi-tenant runtime with AI features",
    "subtitle": "Pooled tenants reach APIs and agents through one authenticated edge; every AI call is tenant-bound (inference profile, retrieval filter, memory namespace, Cedar tool policy) and observed in Amazon CloudWatch Omni",
    "lens": [
      "framework",
      "generative-ai"
    ],
    "review": false,
    "cost": {
      "note": "Illustrative: 50 tenants, ~3M API requests and ~400k agent invocations per month. Replace usage with real numbers before quoting."
    }
  },
