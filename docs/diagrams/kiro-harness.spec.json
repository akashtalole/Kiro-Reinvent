  "edges": [
    {
      "from": "dev",
      "to": "cli",
      "step": 1,
      "label": "prompt",
      "desc": "You type in the IDE chat or the CLI; both are clients of the same harness."
    },
    {
      "from": "cli",
      "to": "loop",
      "step": 2,
      "label": "ACP (stdio)",
      "desc": "Local clients talk to the harness over the Agent Client Protocol (JSON-RPC over stdio), with Kiro-specific _kiro/ extensions for steering, specs, permission prompts and context tracking."
    },
    {
      "from": "context",
      "to": "loop",
      "step": 3,
      "label": "assemble",
      "desc": "Prompt, history, steering and the active spec are always loaded; skills and powers load on demand; Prompt Submit hooks run."
    },
    {
      "from": "loop",
      "to": "bedrock",
      "step": 4,
      "label": "inference",
      "desc": "The request goes to the chosen model or the Auto router. Kiro is powered by Amazon Bedrock with cross-region inference (US or EU profile)."
    },
    {
      "from": "loop",
      "to": "perm",
      "step": 5,
      "label": "tool call",
      "desc": "Every tool call is checked against permission rules (deny > ask > allow) and kiroignore; Pre Tool Use hooks can block it."
    },
    {
      "from": "perm",
      "to": "tools",
      "step": 6,
      "label": "allowed",
      "desc": "Allowed tools run; shell commands can run inside the local OS sandbox (Seatbelt or bwrap). Post Tool Use hooks run and results feed back into the loop."
    },
    {
      "from": "tools",
      "to": "mcp",
      "step": 7,
      "label": "MCP",
      "desc": "MCP tools reach local (stdio) or remote servers, loaded on demand with tool search."
    },
    {
      "from": "perm",
      "to": "perms",
      "style": "dashed",
      "label": "rules"
    }
  ]
}