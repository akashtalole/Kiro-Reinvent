  "edges": [
    {
      "from": "users",
      "to": "dash",
      "step": 1,
      "label": "message",
      "desc": "A person writes in the dashboard, a channel thread, or the CLI."
    },
    {
      "from": "dash",
      "to": "hooks",
      "step": 2,
      "label": "HTTP, WebSocket",
      "desc": "Every surface reaches the same gateway; channel senders must pass the owner lock first."
    },
    {
      "from": "owner",
      "to": "hooks",
      "style": "dashed",
      "label": "channels"
    },
    {
      "from": "hooks",
      "to": "session",
      "step": 3,
      "label": "session_key",
      "desc": "Hooks can auto-reply, transform, inject or block; the message is then routed to a session keyed by its origin (thread, slot, cron, subagent, task step)."
    },
    {
      "from": "session",
      "to": "context",
      "step": 4,
      "label": "assemble",
      "desc": "Context assembly adds memory, skills, lessons, recent history and cross-session awareness within a token budget."
    },
    {
      "from": "context",
      "to": "memory",
      "style": "dashed",
      "label": "recall"
    },
    {
      "from": "session",
      "to": "acp",
      "step": 5,
      "label": "prompt",
      "desc": "The session hands the enriched prompt to its ACP connection (warm or cold harness process)."
    },
    {
      "from": "acp",
      "to": "agent",
      "step": 6,
      "label": "ACP stdio",
      "desc": "JSON-RPC 2.0 over stdio to kiro-cli acp; the harness owns the LLM connection, tools, MCP and compaction."
    },
    {
      "from": "agent",
      "to": "llm",
      "step": 7,
      "label": "inference",
      "desc": "The harness streams tokens and tool calls from the model through its own authenticated connection."
    },
    {
      "from": "acp",
      "to": "gate",
      "step": 8,
      "label": "permission?",
      "desc": "Before running a tool the harness asks permission over ACP; the ACP client consults Kiro Crew's own PreToolUse gate (deny rules, sensitive paths, governance ceiling POLICY ∩ PROFILE from trust-root files) and answers allow or deny. Decisions go to the hash-chained security event log.",
      "arrow": "both"
    },
    {
      "from": "agent",
      "to": "tools",
      "step": 9,
      "label": "allowed",
      "desc": "Allowed tools run inside the OS sandbox (Linux namespaces or macOS Seatbelt); output is redacted before it leaves."
    },
    {
      "from": "agent",
      "to": "mcpd",
      "step": 10,
      "label": "MCP",
      "desc": "MCP tools go through Kiro Crew's pooled MCP gateway daemon, a separate process shared across sessions."
    },
    {
      "from": "mcpd",
      "to": "ext",
      "style": "dashed",
      "label": "proxy"
    },
    {
      "from": "cron",
      "to": "session",
      "style": "dashed"
    },
    {
      "from": "tasks",
      "to": "session",
      "style": "dashed",
      "label": "open sessions"
    }
  ]
