<object label="6" tooltip="6. JSON-RPC 2.0 over stdio to kiro-cli acp; the harness owns the LLM connection, tools, MCP and compaction." id="b-5"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1154.5" y="345" width="22" height="22" as="geometry"/></mxCell></object>
