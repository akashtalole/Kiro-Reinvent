<mxCell id="title" value="Kiro Crew — under the hood" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1974" height="30" as="geometry"/></mxCell>
