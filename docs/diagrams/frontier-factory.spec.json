  "edges": [
    {
      "from": "owners",
      "to": "crew",
      "step": 1,
      "label": "intent",
      "desc": "Humans write intent: a spec with testable acceptance criteria, a budget, and the boundary the work must stay inside."
    },
    {
      "from": "crew",
      "to": "builders",
      "step": 2,
      "label": "dispatch",
      "desc": "The Crew conductor decomposes the spec and dispatches headless Kiro CLI workers, one isolated worktree each."
    },
    {
      "from": "builders",
      "to": "verify",
      "step": 3,
      "label": "PR",
      "desc": "Workers self-verify locally, then open a pull request; CodeBuild runs the verification mesh: tests, property-based tests, mutation score, SAST, secret scan, cost diff."
    },
    {
      "from": "verify",
      "to": "pipeline",
      "step": 4,
      "label": "merge on green",
      "desc": "When every automated gate and an independent AI review pass, the merge queue merges without a human click."
    },
    {
      "from": "pipeline",
      "to": "app",
      "step": 5,
      "label": "canary",
      "desc": "Progressive delivery behind a feature flag with automatic rollback on SLO alarms."
    },
    {
      "from": "app",
      "to": "cw",
      "step": 6,
      "label": "telemetry",
      "desc": "SLOs, traces and business metrics decide whether the change stays."
    },
    {
      "from": "devops",
      "to": "ledger",
      "step": 7,
      "label": "fix task",
      "desc": "On a regression the pipeline rolls back first; DevOps Agent's root cause is written to the work ledger as a new fix task, which the Crew conductor picks up."
    },
