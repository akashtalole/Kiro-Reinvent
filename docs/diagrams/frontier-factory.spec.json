{
  "meta": {
    "title": "Frontier engineering team — an autonomous software factory on AWS",
    "subtitle": "Humans set intent and boundaries; Kiro Crew and headless Kiro CLI agents build, verify, ship and fix. Automated gates replace per-change approval; only irreversible actions stay human-gated",
    "lens": [
      "framework",
      "generative-ai"
    ],
    "review": false,
    "cost": {
      "note": "Illustrative: one m7g.2xlarge Crew host, ~2,000 CodeBuild build-minutes and ~300 pipeline runs per month. Kiro usage is billed as Kiro credits, not shown here."
    }
  },
