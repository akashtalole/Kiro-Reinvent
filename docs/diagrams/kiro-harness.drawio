<mxCell id="n-cfg" value=".kiro/ in the repo&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;steering, specs, agents, hooks, skills&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.folders;" vertex="1" parent="g-kirohome"><mxGeometry x="106.5" y="48" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="n-perms" value="permissions.yaml&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;user and workspace scopes&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.json_script;" vertex="1" parent="g-kirohome"><mxGeometry x="417.5" y="48" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="n-sessions" value="~/.kiro/sessions&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;resume, /sessions&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.logs;" vertex="1" parent="g-kirohome"><mxGeometry x="669.5" y="48" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="n-mem" value="~/.kiro/memories&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#545B64&quot;&gt;shared by IDE and CLI&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_database;" vertex="1" parent="g-kirohome"><mxGeometry x="910" y="48" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="e-0" value="prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#232F3E;endArrow=open;endFill=0;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n-dev" target="n-cli"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<object label="1" tooltip="1. You type in the IDE chat or the CLI; both are clients of the same harness." id="b-0"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="133" y="345" width="22" height="22" as="geometry"/></mxCell></object>
<mxCell id="e-1" value="ACP (stdio)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#232F3E;endArrow=open;endFill=0;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n-cli" target="n-loop"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<object label="2" tooltip="2. Local clients talk to the harness over the Agent Client Protocol (JSON-RPC over stdio), with Kiro-specific _kiro/ extensions for steering, specs, permission prompts and context tracking." id="b-1"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350.5" y="345" width="22" height="22" as="geometry"/></mxCell></object>
<mxCell id="e-2" value="assemble" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#232F3E;endArrow=open;endFill=0;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=48;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n-context" target="n-loop"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<object label="3" tooltip="3. Prompt, history, steering and the active spec are always loaded; skills and powers load on demand; Prompt Submit hooks run." id="b-2"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="582" y="289" width="22" height="22" as="geometry"/></mxCell></object>
<mxCell id="e-3" value="inference" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#232F3E;endArrow=open;endFill=0;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n-loop" target="n-bedrock"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<object label="4" tooltip="4. The request goes to the chosen model or the Auto router. Kiro is powered by Amazon Bedrock with cross-region inference (US or EU profile)." id="b-3"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="638" y="345" width="22" height="22" as="geometry"/></mxCell></object>
<mxCell id="e-4" value="allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#232F3E;endArrow=open;endFill=0;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n-perm" target="n-tools"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<object label="6" tooltip="6. Allowed tools run; shell commands can run inside the local OS sandbox (Seatbelt or bwrap). Post Tool Use hooks run and results feed back into the loop." id="b-4"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="505" width="22" height="22" as="geometry"/></mxCell></object>
<mxCell id="e-5" value="MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#232F3E;endArrow=open;endFill=0;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n-tools" target="n-mcp"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<object label="7" tooltip="7. MCP tools reach local (stdio) or remote servers, loaded on demand with tool search." id="b-5"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200.5" y="505" width="22" height="22" as="geometry"/></mxCell></object>
<mxCell id="e-6" value="tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#232F3E;endArrow=open;endFill=0;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=48;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n-loop" target="n-perm"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="593" y="460"/><mxPoint x="877" y="460"/></Array></mxGeometry></mxCell>
<object label="5" tooltip="5. Every tool call is checked against permission rules (deny &gt; ask &gt; allow) and kiroignore; Pre Tool Use hooks can block it." id="b-6"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="582" y="449" width="22" height="22" as="geometry"/></mxCell></object>
<mxCell id="e-7" value="rules" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#232F3E;endArrow=open;endFill=0;endSize=8;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n-perm" target="n-perms"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="756.5" y="516"/></Array></mxGeometry></mxCell>
